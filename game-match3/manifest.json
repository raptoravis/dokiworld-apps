{
  "schemaVersion": 2,
  "version": "1.0.4",
  "id": "game-match3",
  "kind": "game",
  "status": "active",
  "capability": "game.puzzle.match-three",
  "entry": "index.html",
  "launchRequirements": {
    "minPlayers": 2
  },
  "context": {
    "requiredScopes": [],
    "optionalScopes": []
  },
  "locales": {
    "en": {
      "name": "Heartline Match",
      "description": "Connect matching signals before time runs out.",
      "aliases": [
        "Match Three",
        "Match-3",
        "match-three game"
      ]
    },
    "zh-cn": {
      "name": "心意连线",
      "description": "在时间结束前连接相同信号。",
      "aliases": [
        "三消",
        "心意连线",
        "玩三消"
      ]
    }
  },
  "selection": {
    "activationPolicy": "explicit-or-contextual",
    "promptHint": {
      "en": "Use for an explicit match-three request or a short reflex challenge.",
      "zh-cn": "玩家明确要玩三消，或剧情确实需要短时反应挑战时使用。"
    },
    "avoidHint": {
      "en": "Do not infer the game from ordinary mentions of matching three clues.",
      "zh-cn": "普通叙事中提到对应三条线索时不要误拉起。"
    }
  },
  "runtime": {
    "protocol": "dokiworld.app",
    "protocolVersion": 2,
    "input": {
      "contract": "doki.game.match3-input",
      "version": 1
    },
    "outputs": [
      {
        "contract": "doki.game.result",
        "version": 1
      }
    ],
    "extensions": [
      "resize",
      "progress",
      "checkpoint"
    ]
  }
}
