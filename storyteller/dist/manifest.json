{
  "schemaVersion": 2,
  "version": "1.1.18",
  "id": "storyteller",
  "chatLaunchable": false,
  "status": "active",
  "entry": "index.html",
  "runtime": {
    "protocol": "dokiworld.app",
    "protocolVersion": 2,
    "input": {
      "contract": "doki.world.storyteller-input",
      "version": 1
    },
    "outputs": [
      {
        "contract": "doki.world.session-result",
        "version": 1
      }
    ],
    "extensions": [
      "world",
      "episode",
      "chat",
      "dialogue",
      "media",
      "speech",
      "storage",
      "character",
      "persona",
      "apps",
      "checkpoint"
    ]
  },
  "episodeRenderer": true,
  "launchRequirements": {
    "minPlayers": 1
  },
  "context": {
    "requiredScopes": [],
    "optionalScopes": [
      "character.identity",
      "character.avatar",
      "character.card",
      "player_persona"
    ]
  },
  "locales": {
    "en": {
      "name": "Storyteller",
      "description": "A cinematic player for interactive episodes with dialogue, media, choices, and app launches."
    },
    "zh-cn": {
      "name": "故事演绎",
      "description": "用于演绎互动剧集的电影式播放器，支持对话、媒体、选择与应用拉起。"
    }
  }
}
